{% schema %}
{
    "name": "Expandable Content",
    "settings": [
        {
            "type": "text",
            "id": "main_title",
            "label": "Title"
        },
        {
            "type": "richtext",
            "id": "main_description",
            "label": "Description"
        }
    ],
    "blocks": [
        {
            "type": "content_block",
            "name": "Content Block (Column 1)",
            "settings": [
                {
                    "type": "text",
                    "id": "title",
                    "label": "Content Title"
                },
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "Content Text"
                }
            ]
        },
        {
            "type": "image_block",
            "name": "Image Block (Column 2)",
            "limit": 2,
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "image_title",
                    "label": "Title"
                },
                {
                    "type": "image_picker",
                    "id": "icon_list_1",
                    "label": "Icon List Image 1"
                },
                {
                    "type": "image_picker",
                    "id": "icon_list_2",
                    "label": "Icon List Image 2"
                },
                {
                    "type": "image_picker",
                    "id": "icon_list_3",
                    "label": "Icon List Image 3"
                },
                {
                    "type": "text",
                    "id": "text_list_1",
                    "label": "Text List Image 1"
                },
                {
                    "type": "text",
                    "id": "text_list_2",
                    "label": "Text List Image 2"
                },
                {
                    "type": "text",
                    "id": "text_list_3",
                    "label": "Text List Image 3"
                }
            ]
        }
    ],
    "max_blocks": 10,
    "presets": [
        {
            "name": "Expandable Content"
        }
    ]
}
{% endschema %}

<div class="expandable-content section">
    <div class="expandable-content__columns">
        <!-- Column 1 -->
        <div class="expandable-content__col expandable-content__col--left">
            {% if section.settings.main_title != blank %}
                <h2 class="section__title">{{ section.settings.main_title }}</h2>
            {% endif %}
            {% if section.settings.main_description != blank %}
                <div class="expandable-content__description">
                    {{ section.settings.main_description }}
                </div>
            {% endif %}
            <div class="expandable-content__blocks">
                {% for block in section.blocks %}
                    {% if block.type == 'content_block' %}
                        {%- render 'collapsible-row-list-item',
                            block: block,
                            item_heading_font: 'heading',
                            forloop: forloop
                        -%}
                        <div class="expandable-content__block">
                            {% if block.settings.title != blank %}
                                <h3>{{ block.settings.title }}</h3>
                            {% endif %}
                            {% if block.settings.text != blank %}
                                <div>{{ block.settings.text }}</div>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        <!-- Column 2 -->
        <div class="expandable-content__col expandable-content__col--right">
            {% assign image_blocks = section.blocks | where: "type", "image_block" | slice: 0, 2 %}
            {% for image_block in image_blocks %}
                <div class="expandable-content__image-block">
                    {% if image_block.settings.image != blank %}
                        <img src="{{ image_block.settings.image | img_url: 'medium' }}" alt="{{ image_block.settings.image_title | escape }}">
                    {% endif %}
                    <div class="expandable-content__image-inner">
                        {% if image_block.settings.image_title != blank %}
                            <h4>{{ image_block.settings.image_title }}</h4>
                        {% endif %}
                        <ul class="expandable-content__icon-list">
                            {% for i in (1..3) %}
                                {% assign icon_key = 'icon_list_' | append: i %}
                                {% assign text_key = 'text_list_' | append: i %}
                                {% assign icon_image = image_block.settings[icon_key] %}
                                {% assign icon_text = image_block.settings[text_key] %}

                                {% if icon_image != blank or icon_text != blank %}
                                    <li>
                                    {% if icon_image != blank %}
                                        <img src="{{ icon_image | img_url: 'small' }}" alt="{{ icon_text | escape }}">
                                    {% endif %}
                                    {{ icon_text }}
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>


<div class="video-slider-section {{ section.settings.layout }}">  
  <div class="video-header">
  {% if section.settings.section_heading != blank %}
  <h2>{{ section.settings.section_heading }}</h2>
    {% endif %}
  {% if section.settings.p != blank %}
  <div class='rte'>
    {{ section.settings.p }}
  </div>   
    {% endif %}
  </div>
  <div class="video-slider video-slider{{ section.id }}">
    {% for block in section.blocks %}
      <div class="video-slide">
        <div video_href="{{ block.settings.video_url }}" class="video-lightbox" data-title="{{ block.settings.video_title }}">
          <div class="video_player">
         <svg xmlns="http://www.w3.org/2000/svg" fill="#ffffff" width="60px" height="60px" viewBox="0 0 24 24">
                      <g>
                          <path fill="none" d="M0 0h24v24H0z"></path>   
                          <path d="M12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10-4.477 10-10 10zM10.622 8.415a.4.4 0 0 0-.622.332v6.506a.4.4 0 0 0 .622.332l4.879-3.252a.4.4 0 0 0 0-.666l-4.88-3.252z"></path>
                      </g>      
                    </svg>
          <img src="{{ block.settings.video_thumbnail | img_url: 'master' }}" alt="{{ block.settings.video_title }}">
          </div> 
          {% if block.settings.video_title != blank %}
            <h3 class="multi-column__grid-item-heading ff-heading fs-heading-4-base">{{ block.settings.video_title }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <div class="rte_rte">
            <p class="p2">{{ block.settings.description }}</p>
            </div>  
          {% endif %}
        </div>
      </div>   
    {% endfor %}
  </div>
  <div class="slider_controls">
    <div class="prev_arrow">
      <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="#000000" height="800px" width="800px" version="1.1" id="Layer_1" viewBox="0 0 330 330" xml:space="preserve">
<path id="XMLID_222_" d="M250.606,154.389l-150-149.996c-5.857-5.858-15.355-5.858-21.213,0.001  c-5.857,5.858-5.857,15.355,0.001,21.213l139.393,139.39L79.393,304.394c-5.857,5.858-5.857,15.355,0.001,21.213  C82.322,328.536,86.161,330,90,330s7.678-1.464,10.607-4.394l149.999-150.004c2.814-2.813,4.394-6.628,4.394-10.606  C255,161.018,253.42,157.202,250.606,154.389z"/>
</svg>
    </div>
      <div class="next_arrow">
        <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" fill="#000000" height="800px" width="800px" version="1.1" id="Layer_1" viewBox="0 0 330 330" xml:space="preserve">
<path id="XMLID_222_" d="M250.606,154.389l-150-149.996c-5.857-5.858-15.355-5.858-21.213,0.001  c-5.857,5.858-5.857,15.355,0.001,21.213l139.393,139.39L79.393,304.394c-5.857,5.858-5.857,15.355,0.001,21.213  C82.322,328.536,86.161,330,90,330s7.678-1.464,10.607-4.394l149.999-150.004c2.814-2.813,4.394-6.628,4.394-10.606  C255,161.018,253.42,157.202,250.606,154.389z"/>
</svg>
      </div>
  </div>  
</div>
      
<style>
  .video-lightbox img {
    width: 100%;
    max-height: 33vw;
    object-fit: cover;
}
  .video-lightbox {
    padding: 0 10px;
}
  .rte_rte {
    margin-top: 5px;   
}
  .lightbox-content video {
    width: 100%;
}
 .lightbox-overlay {
  position: fixed;
  top: 0;   
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);    
  display: flex;
  justify-content: center;
  align-items: center;
   padding-top: 4%;
    padding-bottom: 4%;
   overflow-y: scroll;
  z-index: 9999; /* Ensure it's above other elements */
}

.lightbox-content {
    position: relative;
    padding: 20px;
    max-width: 1300px;
    width: 80%;   
    /* height: 100%; */
    display: flex;
    align-items: center;
    justify-content: center;
}
.lightbox-content iframe {
  width: 100%;
  /* height: 50vw; */
}
    
.lightbox-close {
  position: absolute;
  top: -7px;
  right: 1px;   
  background: transparent;
  border: none;
  color: #000;
  font-size: 24px;
  cursor: pointer;
}
  button.lightbox-close {   
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 1;
    background-color: var(--color-background);
    color: var(--color-text);
    box-shadow: var(--box-shadow-double);
    border-radius: 50%;
    transition: transform .2s ease;
    width: 43px;
    height: 43px;
    margin-top: var(--spacing-4);
    margin-right: var(--spacing-4);
}   
  .video_player svg {   
    position: absolute;
    top: 40%;
    left: 0;
    right: 0;
    margin: 0 auto;
    width: 4vw;
    height: 4vw;
}
  .video_player {
    position: relative;
    margin-bottom: 20px;
}
  .video-lightbox p {
    font-size: 16px;
    text-transform: uppercase;
    margin-top: 5px;
}
  .video-lightbox p.p2 {
   font-size: var(--font-size-body-75);
    margin-top: 0;
    text-transform: unset;
}
  .video-slider-section .rte {
    max-width: 693px;
    margin: 0 auto;
    text-align: center;
  }
  .video-header {
    margin-bottom: 20px;
}
  span.icon.icon-new.icon-close {
    display: flex;
    justify-content: center;
    align-items: center;
}
  button.lightbox-close svg {
    width: 18px;
    height: 18px;
}

  @media screen and (min-width: 750px) {
    .lightbox-close {
    position: absolute;
    top: -30px;
    right: -57px;
  }
  }
  
@media screen and (max-width: 750px) {
  .video_player svg {
        position: absolute;
        top: 39%;
        width: 12vw;
        height: 12vw;
    }
  {% if section.settings.stack %}
    .slider_controls {
    display: none;
}
    .video-slide {
    margin-top: 25px;
}
  {% endif %}
  .video-lightbox img {
    max-height: 100vw;
}    
  .slider_controls .slick-arrow svg {
    width: 20px;
    height: 20px;
}
  .lightbox-content iframe {
    width: 100%;
    /* height: 100vw; */
}
     .lightbox-content {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
    }
  .video-slider-section h2 {
    text-align: center;
    margin-bottom: 18px;
    font-size: 20px;
}
}
  </style>
<script>
$(document).ready(function () {    
  let isDragging = false; 
  $('.video-slider{{ section.id }}').slick({
    slidesToShow: {{ section.settings.range }},
    slidesToScroll: {{ section.settings.range }},
    infinite: true,
    dots: false,
    arrows: true,
    prevArrow: ".prev_arrow",
    nextArrow: ".next_arrow",
    responsive: [
      {  
        breakpoint: 1024,
        settings: {
          slidesToShow: 3,
          slidesToScroll: 3,
          infinite: true,
          dots: true
        }
      },
      {
        breakpoint: 600,   
         {% if section.settings.stack %}      
          settings: "unslick"
            {% else %}
        settings: {
          slidesToShow: 2,
          slidesToScroll: 2
        }
            {% endif %}
      },
      {
        breakpoint: 480,
         {% if section.settings.stack %}   
          settings: "unslick"
            {% else %}
        settings: {     
          slidesToShow: 1,
          slidesToScroll: 1
        }
           {% endif %}
      }
    ]
  });
   
  $('.video-slider{{ section.id }}')
    .on('mousedown touchstart', function () {
      isDragging = false;
    })
    .on('mousemove touchmove', function () {
      isDragging = true; 
    });

  $('.video-lightbox').on('click', function (e) {
    if (isDragging) {
      isDragging = false; 
      return; 
    }

    e.preventDefault();

    let videoUrl = $(this).attr('video_href');
    const videoTitle = $(this).data('title');

    $('.lightbox-overlay').remove();

    $('body').append(`
      <div class="lightbox-overlay">
        <div class="lightbox-content">
          <button class="lightbox-close">
            <span class="icon icon-new icon-close ">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.66 1.34 2 .68.68 2l.66.66 1.32-1.32zm18.68 21.32.66.66L23.32 22l-.66-.66-1.32 1.32zm1.32-20 .66-.66L22 .68l-.66.66 1.32 1.32zM1.34 21.34.68 22 2 23.32l.66-.66-1.32-1.32zm0-18.68 10 10 1.32-1.32-10-10-1.32 1.32zm11.32 10 10-10-1.32-1.32-10 10 1.32 1.32zm-1.32-1.32-10 10 1.32 1.32 10-10-1.32-1.32zm0 1.32 10 10 1.32-1.32-10-10-1.32 1.32z" fill="currentColor"></path></svg>
            </span>
          </button>
          <video controls autoplay muted playsinline>
            <source src="${videoUrl}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        </div>
      </div>
    `);

    $('.lightbox-close, .lightbox-overlay').on('click', function () {
      $('.lightbox-overlay').remove();
    });

    $('.lightbox-content').on('click', function (e) {
      e.stopPropagation();
    });
  });
});

</script>

{% schema %}
{
  "name": "Video Slider Section",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Featured Videos"
    },
     {
      "type": "richtext",
      "id": "p",
      "label": "Section Description"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Select Layout",
      "default": "wide",
      "options": [
        {
          "label": "Standard",
          "value": "section"
        },
        {
          "label": "Wide",
          "value": "wide"
        }
      ]
    },
    {
      "type": "range",
      "id": "range",
      "label": "Show slides",
      "min": 2,
      "max": 6,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "stack",
      "label": "Stack On Mobile",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",   
      "settings": [
        {
          "type": "text",
          "id": "video_title",
          "label": "Video Title",
          "default": "My Video"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Video Description"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL"
        },
        
        {
          "type": "image_picker",
          "id": "video_thumbnail",
          "label": "Video Thumbnail"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Slider",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

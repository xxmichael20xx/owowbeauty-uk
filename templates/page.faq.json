    "collapsible_row_list_T8knB6": {
      "type": "collapsible-row-list",
      "blocks": {
        "item_XTm6Rd": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Can I use ANSWR shampoo and conditioner even though I haven't used your keratin treatment?",
            "text": "<p>You sure can! Many of our customers swear by our shampoo and conditioner combo for keeping the hair smooth daily. This are the best products on the market for visibly healthy-looking, smooth hair from the first wash!</p>"
          }
        },
        "item_8EtGUB": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Does the shampoo lather even though it is sulfate-free?",
            "text": "<p>Yes, it does! Knowing how annoying it is when the shampoo doesn’t lather we made sure to optimise our shampoo to be lather-rich.</p>"
          }
        },
        "item_JheDRw": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Is the conditioner silicone-free?",
            "text": "<p>Yes. The formula is three times thicker than regular conditioner and it delivers instant hair mask-like results. The secret is in AHA and pineapple extract, a silicone-free hydration powerhouse that deeply penetrates strands to boost hydration and smoothness.</p>"
          }
        },
        "item_eXcmpD": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Is it suitable for coloured hair?",
            "text": "<p>Yes, the shampoo & conditioner are  both ideal for coloured hair! As they are both sulfate free it doesn't dull or strip your colour and the conditioner restores your hairs vibrancy & shine.</p>"
          }
        }
      },

    "rich_text_TxmaRT": {
      "type": "rich-text",
      "blocks": {
        "heading_fg48hR": {
          "type": "heading",
          "settings": {
            "title": "EXFOLIATING HAIR REMOVAL DROP",
            "heading_tag": "h2",
            "heading_font_class": "fs-heading-3-base"
          }
        }
      },
      "block_order": [
        "heading_fg48hR"
      ],
      "settings": {
        "alignment": "center_center",
        "enable_animation": false,
        "divider_style": "none",
        "section_padding": "section--vertical-padding-top-bottom",

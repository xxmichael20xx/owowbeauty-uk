            "image_link": "",
            "small_caption": "",
            "accent": "",
            "heading": "3. seal",
            "heading_font_class": "fs-heading-3-base",
            "text": "<p>Using a 180°C straightening iron, take narrow sections of hair until all strands are straight. Enjoy silk-like hair for the next three months.</p>",
            "text_font_class": "fs-body-75",
            "text_max_width": 100,
            "link": "",

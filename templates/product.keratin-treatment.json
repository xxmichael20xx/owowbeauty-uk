            "heading": "1. spray",
            "heading_font_class": "fs-heading-3-base",
            "text": "<p>Start with clean, dry hair. Spray the treatment onto your hair until fully saturated, then comb it through. Let it sit for one hour.</p>",
            "text_font_class": "fs-body-75",
            "text_max_width": 100,
            "link": "",

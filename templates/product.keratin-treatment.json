      "block_order": [
        "content_block_9gdkHb",
        "content_block_bGKrQ3",
        "content_block_izfmb8",
        "content_block_YnC7Uh",
        "image_block_yECjyT",
        "image_block_aXWFft"
      ],
      "name": "Expandable Content",
      "settings": {
        "main_title": "Everything your hair needs to shine!",
        "main_description": "<p>Powered by award-winning VeratinTech™ technology, this 100% vegan formula, combined with gentle acids, tames frizz, seals cuticles, and balances your hair’s pH—all while restoring softness and hydration - and cutting the blow dry time into half.<br/><br/>The kit comes with <strong>sulfate free shampoo</strong> and <strong>conditioner</strong> specifically formulated for after treatment care to prolong the effect of the treatment.</p>"
      }
    },

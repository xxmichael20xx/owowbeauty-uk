            "small_caption": "",
            "accent": "",
            "heading": "2. rinse & dry",
            "heading_font_class": "fs-heading-3-base",
            "text": "<p>Rinse your hair thoroughly with only water, ensuring no residue is left behind. Blow-dry your hair completely.</p>",
            "text_font_class": "fs-body-75",
            "text_max_width": 100,
            "link": "",
            "link_text": "",
            "button_style": "btn--primary"
          }
        },
        "9da1dff4-08d1-4978-b4ca-4ec6135acba6": {

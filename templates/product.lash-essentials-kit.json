        },
        "accordion_LfRfJA": {
          "type": "accordion",
          "settings": {
            "expand_by_default": false,
            "column_placement": "right",
            "heading": "INGREDIENTS",
            "heading_tag": "h3",
            "content": "<p><strong>Black Bond: </strong>Acrylic resin, Aqua, CI 77266 (Carbon Black, D&C Black 2, Pigment Black 7)</p><p><strong>Clear Bond: </strong>Acrylic resin, Aqua</p><p><strong>Sealant: </strong>Acrylates/Ethylhexyl Acrylate Copolymer, Aqua, Propylene Glycol, Ethylhexylglycerin, Caprylyl, Glycol, Phenoxyethanol </p>",
            "page_for_content": "",

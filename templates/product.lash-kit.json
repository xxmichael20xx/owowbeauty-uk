    "f6067e5c-800d-40b7-b7ea-bf2d64d882c2": {
      "type": "collapsible-row-list",
      "blocks": {
        "template--16155228307619__f6067e5c-800d-40b7-b7ea-bf2d64d882c2-16753409871715bdf0-0": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "How long do the lashes stay on?",
            "text": "<p>Our lashes are developed to last a minimum of 7 days, but with proper application and care, they can easily stay on for up to 10 days. We recommend watching our tutorial videos for the best tips and techniques to maximize wear time.</p>"
          }
        },
        "template--16155228307619__f6067e5c-800d-40b7-b7ea-bf2d64d882c2-16753409871715bdf0-1": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Does the application require prior experience?",
            "text": "<p>Not at all! Like all of our products, our lashes are made for easy at-home use, with no prior skills required. Thanks to the under-lash cluster method, the application is simple and takes around 10 minutes from start to finish. Just follow the instructions, and you're good to go!</p>"
          }
        },
        "template--16155228307619__f6067e5c-800d-40b7-b7ea-bf2d64d882c2-16753409871715bdf0-2": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "How long does it take to apply the lashes?",
            "text": "<p>Thanks to the under-lash cluster technique, applying a full set of lashes takes just 10 minutes—quick, easy, and completely fuss-free!</p>"
          }
        },
        "item_4mizRy": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Will the lash extensions damage my natural lashes?",
            "text": "<p>No. Unlike traditional salon lash extensions that can create tension due to the fiber-by-fiber application and strong adhesive, our lashes are applied with gentle adhesive in clusters under your natural lashes. This creates no tension and ensures no damage when applied and removed correctly.</p>"
          }
        },
        "item_FxC6AR": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "How do I remove the lashes?",
            "text": "<p>Removing the lashes is easy with our oil-based lash remover and removal pad. No tugging or pulling is required! Watch our \"Removal\" tutorial for step-by-step guidance [HERE].</p>"
          }
        },
        "item_9K7Qh6": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Can I use traditional strip lash adhesive?",
            "text": "<p>This is a big no. Strip lash adhesives are formulated for one-day wear and won’t provide the hold necessary for our at-home lash extensions. Using them will make it impossible for the lashes to stay in place.</p>"
          }
        },
        "item_6ECghc": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "What do I need to get started?",
            "text": "<p>In addition to the tools included in this tool kit you would need our <a href=\"/products/at-home-lash-extensions\" title=\"At-home lash extensions\">pre-mapped lash extensions clusters</a>. </p>"
          }
        },
        "item_fgt9Dp": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "⁠Are the lashes suitable for sensitive eyes?",
            "text": "<p>Yes! Our lashes are made from hypoallergenic materials, and the adhesive is formulated to be gentle enough for sensitive eyes. If you experience any discomfort, it’s likely that the lash clusters were applied too close to your waterline. In this case, or if you feel any burning or irritation, we recommend removing the lashes and reapplying them slightly further from the lash line for a more comfortable fit.</p>"
          }
        },
        "item_wtUDHP": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "How do I care for my lashes to make them last longer?",
            "text": "<p>To maximize the wear time of your lashes, avoid getting them wet for the first 24 hours after application. Additionally, steer clear of oil-based products around your eyes, as these can weaken the adhesive and shorten the life of your lashes.</p>"
          }
        }
      },

    "f6067e5c-800d-40b7-b7ea-bf2d64d882c2": {
      "type": "collapsible-row-list",
      "blocks": {
        "template--16155228307619__f6067e5c-800d-40b7-b7ea-bf2d64d882c2-16753409871715bdf0-0": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Does the shampoo lather even though it is sulfate-free?",
            "text": "<p>Yes, it does! Knowing how annoying it is when the shampoo doesn’t lather we made sure to optimise our shampoo to be lather-rich.</p>"
          }
        },
        "template--16155228307619__f6067e5c-800d-40b7-b7ea-bf2d64d882c2-16753409871715bdf0-1": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Can use this shampoo & conditioner even though i haven't used your keratin treatment?",
            "text": "<p>You sure can! Many of our customers swear by our shampoo and conditioner combo for keeping the hair smooth daily. This are the best products on the market for visibly healthy-looking, smooth hair from the first wash!</p>"
          }
        },
        "template--16155228307619__f6067e5c-800d-40b7-b7ea-bf2d64d882c2-16753409871715bdf0-2": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Is the conditioner silicone-free?",
            "text": "<p>The formula is three times thicker than regular conditioner and it delivers instant hair mask-like results. The secret is in AHA and pineapple extract, a silicone-free hydration powerhouse that deeply penetrates strands to boost hydration and smoothness.</p>"
          }
        },
        "6a9388b5-236d-46e1-acb7-4267a9eb0b51": {
          "type": "item",
          "settings": {
            "expand_by_default": false,
            "icon": "none",
            "title": "Is it good for coloured hair?",
            "text": "<p>Yes, the shampoo & conditioner are  both ideal for coloured hair! As our shampoo is sulfate free it doesn't dull or strip your colour and the conditioner restores your hairs vibrancy & shine.</p>"
          }
        }
      },

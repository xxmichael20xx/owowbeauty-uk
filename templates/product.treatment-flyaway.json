        "template--16155228307619__68f21f02-4e27-439d-8c2d-230d9b48ebc5-167533762479399dd1-0": {
          "type": "heading",
          "settings": {
            "title": "THREE MONTHS OF GLASS-LIKE HAIR",
            "heading_tag": "h2",
            "heading_font_class": "fs-heading-1-base"

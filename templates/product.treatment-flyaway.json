            "heading_font_class": "fs-heading-4-base",
            "text": "<p>A little water and a blast of heat. Rinse the treatment with only water, followed by a good blow dry.</p>",
            "text_font_class": "fs-body-100",
            "text_max_width": 100,
            "link": "",
            "link_text": "",

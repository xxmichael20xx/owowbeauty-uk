    "d926bf47-6f6f-49a1-9b62-72fc031ed23a": {
      "type": "image-with-text",
      "blocks": {
        "da16c318-5892-42fd-a22a-f6e46cb3dec3": {
          "type": "heading",
          "settings": {
            "title": "The sleek look multitasker ",
            "heading_tag": "h2",
            "heading_font_class": "fs-heading-1-base"
